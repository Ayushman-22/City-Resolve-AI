# ── Supabase (required for real auth + database) ──────────────────────────
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=supabse_anon_key_here

# ── OpenAI Vision API (optional — enables AI image analysis) ──────────────
# Get your key at https://platform.openai.com/api-keys
# Without this key the app uses smart mock AI analysis in demo mode
VITE_OPENAI_API_KEY=your_openai_key_here
